# Thin wrapper around prebuilt vLLM images to add fastsafetensors
#
# Usage:
#   docker build -f docker/Dockerfile.vllm-prebuilt \
#     --build-arg BASE_IMAGE=vllm/vllm-openai:v0.13.0 \
#     -t model-bench-vllm-prebuilt:v0.13.0 .

ARG BASE_IMAGE=vllm/vllm-openai:v0.13.0
FROM ${BASE_IMAGE}

# Add fastsafetensors for --load-format fastsafetensors support
RUN pip install --no-cache-dir fastsafetensors

