# vLLM Docker image using CUDA 13.0 wheels for Blackwell GPUs
#
# Fast build (~2 min) using prebuilt wheels from wheels.vllm.ai
# Includes fastsafetensors for GPU Direct Storage model loading.
#
# Build:
#   docker build -f docker/Dockerfile.vllm --build-arg VERSION=nightly -t model-bench-vllm:nightly .
#
# VERSION can be: "nightly" or a specific commit hash (e.g., da6709c9...)

ARG VERSION=nightly
FROM nvidia/cuda:13.0.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Re-declare after FROM
ARG VERSION

# Install vLLM from cu130 wheels (precompiled for Blackwell with compute capability 10.0)
# The cu130 wheels include torch compiled with CUDA 13.0 and torch_cuda_arch_list='9.0 10.0+PTX'
# Use --pre to allow pre-release versions from the cu130 index
# Use --index-url (not --extra-index-url) to prioritize the cu130 wheels over PyPI
RUN pip3 install --no-cache-dir --pre \
    vllm \
    fastsafetensors \
    --index-url https://wheels.vllm.ai/${VERSION}/cu130 \
    --extra-index-url https://pypi.org/simple

EXPOSE 8000
WORKDIR /workspace

# Default entrypoint: vLLM OpenAI-compatible server
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
